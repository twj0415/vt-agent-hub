{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit(D:/project/vt-agent-hub/**)",
      "Write(D:/project/vt-agent-hub/**)",
      "Bash(pnpm *)",
      "Bash(npm *)",
      "Bash(node *)",
      "Bash(npx *)",
      "Bash(cargo *)",
      "Bash(rustc *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git show*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(ls *)",
      "Bash(pwd)",
      "Bash(mkdir *)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(gh *)",
      "Bash(curl *)",
      "Bash(wget *)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git reset --hard*)",
      "Bash(git clean -*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)"
    ],
    "defaultMode": "default"
  }
}
