{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VT Hub Manager",
  "version": "0.1.0",
  "identifier": "com.twj.vt-hub-manager",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:24220"
  },
  "app": {
    "windows": [
      {
        "title": "VT Hub Manager",
        "width": 1440,
        "height": 960,
        "resizable": true,
        "decorations": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["../src/assets/icon.ico"]
  }
}
